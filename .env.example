# ==============================================================================
# AI Engineer OS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, supply these variables via your container environment or secret manager.

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# IMPORTANT: Replace 'password' with a secure password for your local database
DATABASE_URL=postgresql://ai_engineer_os:password@localhost:5432/ai_engineer_os

# Upstream Curriculum Source Configuration
CURRICULUM_GIT_REPO=https://github.com/rohitg00/ai-engineering-from-scratch.git
CURRICULUM_PINNED_SHA=c81651a83aff5f7bf307ffe4392f0d97f3b27ad6
CURRICULUM_LOCAL_PATH=./upstream/ai-engineering-from-scratch

# Auth.js / NextAuth v5 Configuration
# Generate a secure secret using: openssl rand -base64 32
# Required for API authentication to work
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth
AUTH_TRUST_HOST=true

# OAuth Providers (required for user authentication)
# At least one provider must be configured for users to sign in
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MCP Configuration (for remote agent access)
MCP_ALLOWED_ORIGINS=https://*.cursor.com,https://*.claude.ai
MCP_RATE_LIMIT_REQUESTS=60
MCP_RATE_LIMIT_WINDOW_MS=60000

# Public Feature Flags
NEXT_PUBLIC_ENABLE_GUEST_MODE=true
NEXT_PUBLIC_ENABLE_COMMUNITY_CURATION=true
