      "estimatedMinutes": 480
    }
  ],
  "rubric": {
    "categories": [
      { "id": "correctness", "category": "Functional correctness", "weight": 20, "criteria": ["Typed ingestion", "Retrieval works across modalities", "Answers cite real elements"], "minimumExpectation": "Cross-modal answers with citations", "excellentExpectation": "Fixture tests across document types" },
      { "id": "grounding", "category": "Provenance & honesty", "weight": 25, "criteria": ["Element-level citations", "Figure claims grounded", "Refusal implemented"], "minimumExpectation": "No uncited multimodal claims accepted", "excellentExpectation": "Adversarial unanswerable-question suite" },
