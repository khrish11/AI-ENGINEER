      { "id": "prod", "category": "Serving & ops", "weight": 15, "criteria": ["Traced serving", "Metrics", "Cost notes"], "minimumExpectation": "Serving evidence included", "excellentExpectation": "Latency + cost per modality documented" },
      { "id": "docs", "category": "Documentation", "weight": 15, "criteria": ["Architecture", "Licenses", "Reflection"], "minimumExpectation": "README + reflection", "excellentExpectation": "Compare-and-contrast with single-modal baseline" }
    ],
