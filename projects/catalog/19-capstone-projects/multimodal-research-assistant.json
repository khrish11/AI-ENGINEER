      "requiredEvidence": ["e-api"],
      "estimatedMinutes": 360
    },
    {
      "id": "graded-eval",
      "title": "Cross-modal graded eval + serving",
      "objective": "Grade ≥15 answers across modalities; serve with traces + metrics.",
