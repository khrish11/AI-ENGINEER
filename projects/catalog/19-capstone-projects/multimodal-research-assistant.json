      "requiredEvidence": ["e-repo"],
      "estimatedMinutes": 420
    },
    {
      "id": "cross-retrieval",
      "title": "Cross-modal retrieval",
      "objective": "Retrieve text, figures, and tables jointly with provenance-preserving schema.",
